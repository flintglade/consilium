# Consilium configuration example.
# Copy this file to a supported .env location and uncomment only the route(s)
# you want to use. Installed builds also read:
#   Linux:  ${XDG_CONFIG_HOME:-$HOME/.config}/consilium/.env
#   Windows: %APPDATA%\Flintglade\Consilium\.env
# Consilium reads this file but never creates or updates it.
# Never put a real credential in this tracked example file.

# Optional desktop startup choices. A default provider is used only when it is
# active, available, and Chat-capable; Agent-only CLIs are never selected while
# the desktop starts in Chat mode.
# CONSILIUM_DEFAULT_PROVIDER=openai-compatible
# CONSILIUM_ROUTING_PROFILE=local-first

# Fully local OpenAI-compatible route (Ollama example).
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPAT_MODEL=qwen3:8b
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_NAME=Local Ollama

# Official CLI binary/model overrides. Authentication stays in each CLI.
# Use full paths; values are not shell-expanded. Windows .exe/.cmd/.bat paths
# are supported (quote a dotenv value when it contains spaces).
# GROK_CLI_BIN=/absolute/path/to/grok
# GROK_MODEL=
# CLAUDE_CLI_BIN=/absolute/path/to/claude
# CLAUDE_MODEL=
# CODEX_CLI_BIN=/absolute/path/to/codex
# CODEX_MODEL=
# ANTIGRAVITY_CLI_BIN=/absolute/path/to/agy
# GEMINI_MODEL=

# Optional xAI direct API route.
# XAI_API_KEY=
# GROK_API_URL=https://api.x.ai/v1/chat/completions

# Optional OpenAI direct API route.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional Anthropic direct API route.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Optional Gemini Developer API route.
# GEMINI_API_KEY=
# GEMINI_API_MODEL=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional Mistral direct API route.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Optional DeepSeek direct API route.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Shared direct-API timeout. Defaults to 120 seconds when unset.
# CONSILIUM_API_TIMEOUT_SECS=120

# Terminal frontend only: cli (default) or explicit xAI api mode.
# GROK_BACKEND=cli

# Optional desktop session-store override, useful for testing or custom backup.
# GROK_CHAT_DATA_DIR=/absolute/path/to/consilium-data
# Antigravity passes conversations in process arguments. Leave disabled for
# confidential text/shared hosts; use GEMINI_API_KEY instead. Set to 1 only
# after accepting that local process inspectors may read your prompt.
# CONSILIUM_ALLOW_VISIBLE_PROMPTS=0
